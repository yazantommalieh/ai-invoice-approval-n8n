    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const inv = $json.output;\nconst errors = [];\n\nif (!inv.vendor) errors.push(\"missing vendor\");\nif (!inv.invoice_number) errors.push(\"missing invoice number\");\nif (!inv.total || inv.total <= 0) errors.push(\"missing or zero total\");\nif (inv.subtotal && inv.vat && inv.total &&\n    Math.abs(inv.subtotal + inv.vat - inv.total) > 0.05)\n  errors.push(\"subtotal + VAT does not equal total\");\nif (inv.invoice_date && new Date(inv.invoice_date) > new Date())\n  errors.push(\"invoice date in the future\");\n\nconst invoice_key =\n  `${(inv.vendor || \"\").toLowerCase().trim()}|${(inv.invoice_number || \"\").trim()}`;\n\nreturn { json: { ...inv, invoice_key, errors, valid: errors.length === 0 } };"
      },
